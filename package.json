{
  "name": "operations-console",
  "version": "1.4.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/common": "20.3.35",
    "@angular/compiler": "20.3.35",
    "@angular/core": "20.3.35",
    "@angular/forms": "20.3.35",
    "@angular/platform-browser": "20.3.35",
    "@angular/router": "20.3.35",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.9.6",
    "@analogjs/vitest-angular": "2.9.6",
    "@angular/build": "20.3.42",
    "@angular/cli": "20.3.42",
    "@angular/compiler-cli": "20.3.35",
    "angular-eslint": "20.7.0",
    "eslint": "9.39.5",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@angular/build": {
      "vitest": "4.1.12"
    }
  }
}
